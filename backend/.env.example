# ============================================================
# HOOPCHAIN Backend — Environment Variables Template
# Copy to .env and fill in values for local development
# ============================================================

# Database (local: use docker-compose values)
DATABASE_URL=postgresql+asyncpg://hoopchain:hoopchain_dev@localhost:5432/hoopchain

# Redis
REDIS_URL=redis://localhost:6379

# Graph pickle path (relative to backend/ directory, or absolute)
GRAPH_PICKLE_PATH=../data/exports/graph.pkl

# Set to "true" to use the mock graph (no ETL required)
USE_MOCK_GRAPH=true

# CORS — comma-separated origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://hoopchain.app"]

# Security
API_SECRET_KEY=dev-secret-key-change-in-production

# Environment
ENVIRONMENT=development

# Kaggle credentials (only needed for ETL scripts, not runtime)
# KAGGLE_USERNAME=your-username
# KAGGLE_KEY=your-api-key
